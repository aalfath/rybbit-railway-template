{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:{$PORT:8080} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	handle /gateway_health {
		respond ok 200
	}
	handle /api/* {
		reverse_proxy {$RYBBIT_BACKEND}
	}
	handle /.well-known/oauth-* {
		reverse_proxy {$RYBBIT_BACKEND}
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy {$RYBBIT_BACKEND}
	}
	handle {
		reverse_proxy {$RYBBIT_CLIENT}
	}
}
